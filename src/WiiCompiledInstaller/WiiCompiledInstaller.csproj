<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WiiCompiled-UWP-Installer</AssemblyName>
    <RootNamespace>WiiCompiledInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.8</Version>
    <Product>WiiCompiled UWP Installer</Product>
    <Copyright>GPL-3.0</Copyright>
    <!-- Portable publish defaults; see publish.ps1. Single-file: the .NET runtime is
         embedded in the exe, certs\ and patches\ stay loose next to it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bundled dev-signing certificate ships with the installer folder. -->
    <None Include="..\..\certs\**\*" Condition="Exists('..\..\certs')" CopyToOutputDirectory="PreserveNewest" LinkBase="certs\" />
    <!-- Port patches for the UWP dependency trees (SDL3-uwp fork + pinned Dawn). -->
    <None Include="..\..\patches\**\*" Condition="Exists('..\..\patches')" CopyToOutputDirectory="PreserveNewest" LinkBase="patches\" />
  </ItemGroup>

</Project>

