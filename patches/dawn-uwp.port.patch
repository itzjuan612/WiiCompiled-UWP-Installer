diff --git a/CMakeLists.txt b/CMakeLists.txt
index 9a90f5b74..94b972c02 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -162,6 +162,14 @@ option(DAWN_USE_GLFW "Enable compilation of the GLFW windowing utils" ${DAWN_SUP
 option(DAWN_USE_WINDOWS_UI "Enable support for Windows UI surface" ${USE_WINDOWS_UI})
 option(DAWN_USE_BUILT_DXC "Enable building and using DXC by the D3D12 backend" OFF)
 option(DAWN_DXC_ENABLE_ASSERTS_IN_NDEBUG "Enable DXC asserts in non-debug builds" ON)
+option(DAWN_USE_DXC_LOADER "Enable the runtime-loaded DXC path (dxcompiler.dll/dxil.dll) without building DXC" OFF)
+# UWP/Xbox: this vendored tree has no DXC sources, but Dawn only needs <dxcapi.h> plus a
+# runtime-loaded dxcompiler.dll, so enable the DXC code path (the DAWN_USE_BUILT_DXC compile
+# definition) while skipping AddSubdirectoryDXC() and the dxcompiler link. Aurora probes the DLLs
+# at adapter setup and falls back to legacy FXC if they are unavailable.
+if (CMAKE_SYSTEM_NAME STREQUAL "WindowsStore" AND NOT DAWN_USE_BUILT_DXC)
+  set(DAWN_USE_DXC_LOADER ON)
+endif()
 option(DAWN_TARGET_MACOS "Manually link Apple core frameworks" ${TARGET_MACOS})
 
 option(DAWN_BUILD_SAMPLES "Enables building Dawn's samples" ${BUILD_SAMPLES})
diff --git a/src/dawn/native/CMakeLists.txt b/src/dawn/native/CMakeLists.txt
