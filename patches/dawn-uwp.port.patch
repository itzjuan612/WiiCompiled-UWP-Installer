@@ -44,6 +46,7 @@
 #include "src/dawn/native/d3d12/PlatformFunctionsD3D12.h"
 #include "src/dawn/native/d3d12/UtilsD3D12.h"
 #include "src/utils/compiler.h"
+#include "src/utils/log.h"
 #include "src/utils/platform.h"
 
 namespace dawn::native::d3d12 {
@@ -615,16 +618,37 @@ void PhysicalDevice::CleanUpDebugLayerFilters() {
 
 void PhysicalDevice::SetupBackendAdapterToggles(dawn::platform::Platform* platform,
                                                 TogglesState* adapterToggles) const {
-    // We don't check if the compiler libraries is available here. Compiler libraries are checked
-    // and loaded according to device's UseDXC toggle during device creation, and the creation would
-    // just fail if required compiler is not available. This is to avoid expensive loading of DLLs
-    // that we will not use immediately (or at all).
+    // We don't check if the compiler libraries are available here in general. Compiler libraries
+    // are checked and loaded according to device's UseDXC toggle during device creation, and the
+    // creation would just fail if the required compiler is not available. This is to avoid
+    // expensive loading of DLLs that we will not use immediately (or at all). The one exception is
+    // the runtime-loaded DXC probe below, which only checks that the DLLs can be opened.
 #ifdef DAWN_USE_BUILT_DXC
     if (GetDeviceInfo().highestSupportedShaderModel < 60) {
         // If shader model < 6.0, though, we must use FXC.
         adapterToggles->ForceSet(Toggle::UseDXC, false);
     }
-    const bool useDxc = platform->IsFeatureEnabled(dawn::platform::Features::kWebGPUUseDXC);
+    bool useDxc = platform->IsFeatureEnabled(dawn::platform::Features::kWebGPUUseDXC);
+    // This build enables Dawn's DXC code path but does not link DXC (the vendored tree has no DXC
+    // sources); the compiler is loaded at runtime from dxcompiler.dll/dxil.dll shipped beside the
+    // Dawn DLL. Probe the libraries here at adapter setup so a missing or unloadable library falls
+    // back to legacy FXC instead of failing device creation. (Legacy FXC fails to compile some GX
+    // pipelines on the Xbox driver with E_OUTOFMEMORY, so DXC is preferred when available.) Device
+    // creation still re-loads the libraries in EnsureCompilerLibraries().
+    if (useDxc) {
+        std::span<const std::string> searchPaths =
+            GetBackend()->GetInstance()->GetRuntimeSearchPaths();
+        DynamicLib dxilProbe;
+        std::string probeError;
+        useDxc = dxilProbe.Open("dxil.dll", searchPaths, &probeError) &&
+                 DynamicLib{}.Open("dxcompiler.dll", searchPaths, &probeError);
+        if (!useDxc) {
+            dawn::WarningLog()
+                << "DXC libraries (dxil.dll/dxcompiler.dll) are unavailable on this system; the "
+                   "D3D12 backend will fall back to legacy FXC. Probe error: "
+                << probeError;
+        }
+    }
     adapterToggles->Default(Toggle::UseDXC, useDxc);
 #else
     adapterToggles->ForceSet(Toggle::UseDXC, false);
