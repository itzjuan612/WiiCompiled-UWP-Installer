@@ -980,9 +980,11 @@ if (DAWN_USE_X11)
 endif()
 
 if (DAWN_ENABLE_D3D12)
-    if (DAWN_USE_BUILT_DXC)
+    if (DAWN_USE_BUILT_DXC OR DAWN_USE_DXC_LOADER)
         target_compile_definitions(dawn_native PRIVATE "DAWN_USE_BUILT_DXC")
         target_compile_definitions(dawn_native_objects PRIVATE "DAWN_USE_BUILT_DXC")
+    endif()
+    if (DAWN_USE_BUILT_DXC)
         add_dependencies(dawn_native copy_dxil_dll)
     endif()
 endif()
diff --git a/src/dawn/native/d3d/D3DError.h b/src/dawn/native/d3d/D3DError.h
index 95d5b5963..bd8271528 100644
--- a/src/dawn/native/d3d/D3DError.h
+++ b/src/dawn/native/d3d/D3DError.h
@@ -28,6 +28,11 @@
 #ifndef SRC_DAWN_NATIVE_D3D_D3DERROR_H_
 #define SRC_DAWN_NATIVE_D3D_D3DERROR_H_
 
+// HRESULT is declared in windef.h. On the UWP (WINAPI_FAMILY_APP) header chain,
+// <winerror.h> alone does not pull in windef.h, so include it explicitly to
+// make HRESULT (and the SEVERITY_*/FACILITY_* codes used below) available.
+// This is a no-op on desktop where winerror.h already reaches windef.h.
+#include <windef.h>
 #include <winerror.h>
 
 #include "src/dawn/native/Error.h"
diff --git a/src/dawn/native/d3d/PlatformFunctions.cpp b/src/dawn/native/d3d/PlatformFunctions.cpp
index 9f5cd6e94..e899fa522 100644
--- a/src/dawn/native/d3d/PlatformFunctions.cpp
+++ b/src/dawn/native/d3d/PlatformFunctions.cpp
@@ -27,8 +27,21 @@
 
 #include "src/dawn/native/d3d/PlatformFunctions.h"
 
+// <comdef.h> is a desktop-OLE header that does not compile under the UWP Store
+// API partition (WINAPI_FAMILY=WINAPI_FAMILY_APP): it references OleRun,
+// CLSIDFromProgID, lstrlen and an incomplete IErrorInfo. This TU uses none of
+// its symbols (it only needs Windows + DXGI + D3D compiler entry points), so
+// include it on desktop only. No-op on desktop.
+#if !defined(WINAPI_FAMILY)
 #include <comdef.h>
+#endif
+// <versionhelpers.h> (IsWindows10OrGreater) is a desktop-only header; it is not
+// part of the UWP Store API partition (WINAPI_FAMILY_APP). It is only needed on
+// the desktop path below; on UWP the build number stays 0 (unknown). No-op on
+// desktop.
+#if !DAWN_PLATFORM_IS(WINUWP)
 #include <versionhelpers.h>
+#endif
 
 #include <vector>
 
@@ -123,9 +136,16 @@ MaybeError PlatformFunctions::EnsureFXC(std::span<const std::string> searchPaths
 
 void PlatformFunctions::InitWindowsVersion() {
     // Currently we only care about the build number of Windows 10 and Windows 11.
+    // On UWP/Xbox the OS is always Windows 10+, and versionhelpers.h is a
+    // desktop-only header, so force the check to true there (the registry read
+    // below is a no-op on UWP).
+#if DAWN_PLATFORM_IS(WINUWP)
+    (void)0;  // force-true; build number stays 0 (unknown) on UWP
+#else
     if (!IsWindows10OrGreater()) {
         return;
     }
+#endif
 
 #if !DAWN_PLATFORM_IS(WINUWP)
     // Referenced from base/win/windows_version.cc in Chromium
diff --git a/src/dawn/native/d3d12/ComputePipelineD3D12.cpp b/src/dawn/native/d3d12/ComputePipelineD3D12.cpp
index eeec973c0..648ba0fed 100644
--- a/src/dawn/native/d3d12/ComputePipelineD3D12.cpp
+++ b/src/dawn/native/d3d12/ComputePipelineD3D12.cpp
@@ -128,9 +128,14 @@ ResultOrError<Extent3D> ComputePipeline::InitializeImpl() {
         // Cache misses, need to get pipeline cached blob and store.
         cacheTimer.RecordMicroseconds("D3D12.CreateComputePipelineState.CacheMiss");
         ComPtr<ID3DBlob> d3dBlob;
-        if (!device->GetInstance()->ConsumedError(
-                CheckHRESULT(GetPipelineState()->GetCachedBlob(&d3dBlob),
-                             "D3D12 compute pipeline state get cached blob"))) {
+        // Getting the cached blob is a best-effort optimization to seed the persistent blob
+        // cache. Some drivers (e.g. the Xbox SraKmd driver) remove the device as a side effect
+        // of the GetCachedBlob() call itself, even though the pipeline state was created
+        // successfully above. Ignoring the HRESULT is not enough there, so skip the call
+        // entirely when the blob cache is disabled (aurora enables Toggle::DisableBlobCache on
+        // the UWP/Xbox partition).
+        if (!device->IsToggleEnabled(Toggle::DisableBlobCache) &&
+            SUCCEEDED(GetPipelineState()->GetCachedBlob(&d3dBlob))) {
             device->StoreCachedBlob(GetCacheKey(), CreateBlob(std::move(d3dBlob)));
         }
     } else {
