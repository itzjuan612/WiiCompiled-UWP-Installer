diff --git a/absl/time/internal/cctz/src/time_zone_lookup.cc b/absl/time/internal/cctz/src/time_zone_lookup.cc
index 8979174..05a9bf5 100644
--- a/absl/time/internal/cctz/src/time_zone_lookup.cc
+++ b/absl/time/internal/cctz/src/time_zone_lookup.cc
@@ -38,9 +38,18 @@
 // targeted for Windows XP and later.
 // Note: The Windows SDK added windows.globalization.h file for Windows 10, but
 // MinGW did not add it until NTDDI_WIN10_NI (SDK version 10.0.22621.0).
+//
+// Exclude Store (UWP) builds: on UWP the UWP Clang wrapper sets
+// _WIN32_WINNT=0x0A00 + a modern NTDDI_VERSION, so the guard above would be
+// true and pull in <windows.globalization.h> -> <windows.foundation.h>. The
+// vendored mingw windows.foundation.h has a C++ redefinition bug under
+// WINAPI_FAMILY=WINAPI_FAMILY_APP, and the WinRT Calendar local-timezone lookup
+// is not used by our UWP (Dawn) build anyway. WINAPI_FAMILY is defined only for
+// Store builds, so this is a no-op on the native desktop build.
 #if ((defined(_WIN32_WINNT_WIN10) && !defined(__MINGW32__)) ||        \
      (defined(NTDDI_WIN10_NI) && NTDDI_VERSION >= NTDDI_WIN10_NI)) && \
-    (_WIN32_WINNT >= _WIN32_WINNT_WINXP)
+    (_WIN32_WINNT >= _WIN32_WINNT_WINXP) &&                           \
+    !defined(WINAPI_FAMILY)
 #define USE_WIN32_LOCAL_TIME_ZONE
 #include <roapi.h>
 #include <tchar.h>
